{
  "$id": "ssyung/Staff",
  "x-contract-version": "0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^A\\d{2,3}$",
      "description": "지원인력 코드 (A01)"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "availability": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          }
        },
        "required": [
          "day",
          "start",
          "end"
        ]
      }
    }
  },
  "required": [
    "code",
    "label",
    "availability"
  ]
}
