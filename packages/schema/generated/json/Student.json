{
  "$id": "ssyung/Student",
  "x-contract-version": "0.3.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^S\\d{2,3}$",
      "description": "학생 코드 (S01)"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "class_group": {
      "type": "string",
      "pattern": "^\\d-\\d{1,2}$",
      "description": "원반 (3-2)"
    },
    "special_class_subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20,
        "description": "NEIS 과목명 (과학)"
      },
      "description": "특수학급에서 듣는 과목. 소속 특수학급은 없고, 장소는 그 요일·시각에 그 과목을 하는 특수학급 (D25)"
    },
    "support_subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "NEIS 과목명 (과학)"
          },
          "need_start": {
            "type": "boolean"
          },
          "need_mid": {
            "type": "boolean"
          },
          "need_end": {
            "type": "boolean"
          }
        },
        "required": [
          "subject",
          "need_start",
          "need_mid",
          "need_end"
        ]
      }
    },
    "support_note": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "code",
    "label",
    "class_group",
    "special_class_subjects",
    "support_subjects",
    "support_note"
  ]
}
