{
  "$id": "ssyung/Student",
  "x-contract-version": "0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^S\\d{2,3}$",
      "description": "학생 코드 (S01)"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "class_group": {
      "type": "string",
      "pattern": "^\\d-\\d{1,2}$",
      "description": "원반 (3-2)"
    },
    "special_class": {
      "type": "string",
      "pattern": "^K\\d{1,2}$",
      "description": "특수학급 코드 (K1)"
    },
    "special_class_subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "NEIS 과목명 (과학)"
          },
          "location": {
            "type": "string",
            "pattern": "^(\\d-\\d{1,2}|K\\d{1,2}|L\\d{2,3})$",
            "description": "그 과목 수업 장소. 과목마다 다를 수 있음 (D20)"
          }
        },
        "required": [
          "subject",
          "location"
        ]
      }
    },
    "support_subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "NEIS 과목명 (과학)"
          },
          "need_start": {
            "type": "boolean"
          },
          "need_mid": {
            "type": "boolean"
          },
          "need_end": {
            "type": "boolean"
          }
        },
        "required": [
          "subject",
          "need_start",
          "need_mid",
          "need_end"
        ]
      }
    },
    "support_note": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "code",
    "label",
    "class_group",
    "special_class",
    "special_class_subjects",
    "support_subjects",
    "support_note"
  ]
}
