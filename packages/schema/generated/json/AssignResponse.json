{
  "$id": "ssyung/AssignResponse",
  "x-contract-version": "0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "optimal",
        "feasible",
        "error"
      ],
      "description": "feasible = 시간 안에 최적을 못 찾아 최선 해"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "staff": {
            "type": "string",
            "pattern": "^A\\d{2,3}$",
            "description": "지원인력 코드 (A01)"
          },
          "demand_id": {
            "type": "string",
            "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "mode": {
            "type": "string",
            "enum": [
              "normal",
              "second_trip"
            ],
            "description": "second_trip = 다음 교시 첫 10분에 데려감 (D22)"
          },
          "pinned": {
            "type": "boolean"
          }
        },
        "required": [
          "staff",
          "demand_id",
          "date",
          "start",
          "end",
          "mode",
          "pinned"
        ]
      }
    },
    "shortfalls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "demand_id": {
            "type": "string",
            "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "short_by": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "priority": {
            "type": "string",
            "enum": [
              "MOVE",
              "HIGH",
              "LOW"
            ]
          },
          "segment": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "start",
                  "mid",
                  "end"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "수업 지원일 때 구간"
          },
          "waived": {
            "type": "boolean",
            "description": "이동이 몰려 일부러 비운 체크 안 된 구간 (EDGE_RELEASED). 지원 공백으로 세지 않음"
          }
        },
        "required": [
          "demand_id",
          "date",
          "start",
          "end",
          "short_by",
          "priority",
          "segment",
          "waived"
        ]
      }
    },
    "solver_meta": {
      "type": "object",
      "properties": {
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "objective_stages": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "§8.3 단계별 목적값"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "elapsed_ms",
        "objective_stages",
        "message"
      ]
    }
  },
  "required": [
    "status",
    "assignments",
    "shortfalls",
    "solver_meta"
  ]
}
