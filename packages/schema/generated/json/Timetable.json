{
  "$id": "ssyung/Timetable",
  "x-contract-version": "0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "enum": [
        "file",
        "neis_api"
      ]
    },
    "date_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD"
    },
    "date_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD"
    },
    "school_days": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "YYYY-MM-DD"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "class_group": {
            "type": "string",
            "pattern": "^\\d-\\d{1,2}$",
            "description": "원반 (3-2)"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "NEIS 과목명 (과학)"
          }
        },
        "required": [
          "class_group",
          "date",
          "period",
          "subject"
        ]
      }
    }
  },
  "required": [
    "source",
    "date_from",
    "date_to",
    "school_days",
    "lessons"
  ]
}
