{
  "$id": "ssyung/DemandSet",
  "x-contract-version": "0.3.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "date_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD"
    },
    "date_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD"
    },
    "version_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "서버가 만드는 불투명 ID"
        },
        {
          "type": "null"
        }
      ],
      "description": "수요를 만든 버전 입력(배치·추가 수요)"
    },
    "absent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "student": {
            "type": "string",
            "pattern": "^S\\d{2,3}$",
            "description": "학생 코드 (S01)"
          }
        },
        "required": [
          "date",
          "student"
        ]
      },
      "description": "결석으로 뺀 학생"
    },
    "unplaced": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "student": {
            "type": "string",
            "pattern": "^S\\d{2,3}$",
            "description": "학생 코드 (S01)"
          },
          "period": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "NEIS 과목명 (과학)"
          },
          "reason": {
            "type": "string",
            "enum": [
              "none",
              "multiple"
            ],
            "description": "none = 그 시각 그 과목을 하는 특수학급 없음, multiple = 둘 이상"
          }
        },
        "required": [
          "date",
          "student",
          "period",
          "subject",
          "reason"
        ]
      },
      "description": "특수학급 수업인데 장소를 정하지 못한 칸 (D25). 이동 수요를 만들지 않는다. 교사가 set_placement로 장소를 지정하면 풀림"
    },
    "demands": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "YYYY-MM-DD"
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "headcount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "lesson"
              },
              "student": {
                "type": "string",
                "pattern": "^S\\d{2,3}$",
                "description": "학생 코드 (S01)"
              },
              "period": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8
              },
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20,
                "description": "NEIS 과목명 (과학)"
              },
              "location": {
                "type": "string",
                "pattern": "^(\\d-\\d{1,2}|K\\d{1,2}|L\\d{2,3})$",
                "description": "장소: 반 코드(원반 교실) | K 코드(특수학급) | L 코드(특별실 등)"
              },
              "floor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  {
                    "type": "string",
                    "const": "OUT"
                  }
                ]
              },
              "segments": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "segment": {
                      "type": "string",
                      "enum": [
                        "start",
                        "mid",
                        "end"
                      ]
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1440,
                      "multipleOf": 10,
                      "description": "자정부터의 분, 10의 배수"
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1440,
                      "multipleOf": 10,
                      "description": "자정부터의 분, 10의 배수"
                    },
                    "priority": {
                      "type": "string",
                      "enum": [
                        "HIGH",
                        "LOW"
                      ]
                    }
                  },
                  "required": [
                    "segment",
                    "start",
                    "end",
                    "priority"
                  ]
                },
                "description": "시작 10 · 중간 20 · 종료 10 (D13). 체크된 구간이 HIGH"
              }
            },
            "required": [
              "id",
              "date",
              "start",
              "end",
              "headcount",
              "kind",
              "student",
              "period",
              "subject",
              "location",
              "floor",
              "segments"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "YYYY-MM-DD"
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "headcount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "move_group"
              },
              "after_period": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "from_floor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  {
                    "type": "string",
                    "const": "OUT"
                  }
                ]
              },
              "to_floor": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  {
                    "type": "string",
                    "const": "OUT"
                  }
                ]
              },
              "students": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "student": {
                      "type": "string",
                      "pattern": "^S\\d{2,3}$",
                      "description": "학생 코드 (S01)"
                    },
                    "from": {
                      "type": "string",
                      "pattern": "^(\\d-\\d{1,2}|K\\d{1,2}|L\\d{2,3})$",
                      "description": "장소: 반 코드(원반 교실) | K 코드(특수학급) | L 코드(특별실 등)"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^(\\d-\\d{1,2}|K\\d{1,2}|L\\d{2,3})$",
                      "description": "장소: 반 코드(원반 교실) | K 코드(특수학급) | L 코드(특별실 등)"
                    },
                    "late_cost": {
                      "anyOf": [
                        {
                          "type": "number",
                          "const": 0
                        },
                        {
                          "type": "number",
                          "const": 1
                        },
                        {
                          "type": "number",
                          "const": 2
                        }
                      ],
                      "description": "늦게 도착 비용 (D22). 0 원반·시작 미체크/지원 없음, 1 특수학급 수업, 2 시작 체크됨"
                    }
                  },
                  "required": [
                    "student",
                    "from",
                    "to",
                    "late_cost"
                  ]
                }
              },
              "late_cost": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 1
                  },
                  {
                    "type": "number",
                    "const": 2
                  }
                ],
                "description": "학생 비용의 최댓값"
              },
              "second_trip": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1440,
                    "multipleOf": 10,
                    "description": "자정부터의 분, 10의 배수"
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1440,
                    "multipleOf": 10,
                    "description": "자정부터의 분, 10의 배수"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "description": "두 번째 이동 허용 구간 = 다음 교시 첫 10분 (D22)"
              }
            },
            "required": [
              "id",
              "date",
              "start",
              "end",
              "headcount",
              "kind",
              "after_period",
              "from_floor",
              "to_floor",
              "students",
              "late_cost",
              "second_trip"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "YYYY-MM-DD"
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "headcount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "requirement"
              },
              "student": {
                "type": "string",
                "pattern": "^S\\d{2,3}$",
                "description": "학생 코드 (S01)"
              }
            },
            "required": [
              "id",
              "date",
              "start",
              "end",
              "headcount",
              "kind",
              "student"
            ]
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "YYYY-MM-DD"
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "headcount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "const": "duty"
              },
              "duty": {
                "type": "string",
                "pattern": "^D\\d{2,3}$",
                "description": "업무 (D01)"
              },
              "location": {
                "type": "string",
                "pattern": "^(\\d-\\d{1,2}|K\\d{1,2}|L\\d{2,3})$",
                "description": "장소: 반 코드(원반 교실) | K 코드(특수학급) | L 코드(특별실 등)"
              },
              "students": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^S\\d{2,3}$",
                  "description": "학생 코드 (S01)"
                }
              }
            },
            "required": [
              "id",
              "date",
              "start",
              "end",
              "headcount",
              "kind",
              "duty",
              "location",
              "students"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "date_from",
    "date_to",
    "version_id",
    "absent",
    "unplaced",
    "demands"
  ]
}
