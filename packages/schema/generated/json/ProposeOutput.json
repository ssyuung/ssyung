{
  "$id": "ssyung/ProposeOutput",
  "x-contract-version": "0.3.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "options": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "policies": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "keep_minimal",
                "fresh",
                "no_late"
              ]
            },
            "description": "같은 결과가 나온 정책은 합친다 (D23)"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "staff": {
                  "type": "string",
                  "pattern": "^A\\d{2,3}$",
                  "description": "지원인력 코드 (A01)"
                },
                "demand_id": {
                  "type": "string",
                  "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "YYYY-MM-DD"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440,
                  "multipleOf": 10,
                  "description": "자정부터의 분, 10의 배수"
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440,
                  "multipleOf": 10,
                  "description": "자정부터의 분, 10의 배수"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "second_trip"
                  ],
                  "description": "second_trip = 다음 교시 첫 10분에 데려감 (D22)"
                },
                "pinned": {
                  "type": "boolean"
                }
              },
              "required": [
                "staff",
                "demand_id",
                "date",
                "start",
                "end",
                "mode",
                "pinned"
              ]
            }
          },
          "shortfalls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "demand_id": {
                  "type": "string",
                  "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "description": "YYYY-MM-DD"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440,
                  "multipleOf": 10,
                  "description": "자정부터의 분, 10의 배수"
                },
                "end": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440,
                  "multipleOf": 10,
                  "description": "자정부터의 분, 10의 배수"
                },
                "short_by": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "priority": {
                  "type": "string",
                  "enum": [
                    "MOVE",
                    "HIGH",
                    "LOW"
                  ]
                },
                "segment": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "start",
                        "mid",
                        "end"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "수업 지원일 때 구간"
                },
                "waived": {
                  "type": "boolean",
                  "description": "이동이 몰려 일부러 비운 체크 안 된 구간 (EDGE_RELEASED). 지원 공백으로 세지 않음"
                }
              },
              "required": [
                "demand_id",
                "date",
                "start",
                "end",
                "short_by",
                "priority",
                "segment",
                "waived"
              ]
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "changed_cells": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "gaps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "waived가 아닌 부족분이 있는 수요 수"
              },
              "late_students": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "second_trip으로 늦게 도착하는 학생 수"
              },
              "notify_staff": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^A\\d{2,3}$",
                  "description": "지원인력 코드 (A01)"
                },
                "description": "배정이 바뀌어 알림 받을 지원인력"
              },
              "staff_minutes": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^A\\d{2,3}$",
                  "description": "지원인력 코드 (A01)"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "pair_share": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^A\\d{2,3}:S\\d{2,3}$"
                },
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "required": [
              "changed_cells",
              "gaps",
              "late_students",
              "notify_staff",
              "staff_minutes",
              "pair_share"
            ]
          },
          "diff": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "demand_id": {
                  "type": "string",
                  "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "removed",
                    "added",
                    "moved",
                    "group",
                    "retimed",
                    "gap"
                  ],
                  "description": "removed 없어짐(빨강) · added 생김(초록) · moved/group/retimed 바뀜(노랑) · gap 맡을 사람 없음"
                },
                "before": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "staff": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^A\\d{2,3}$",
                              "description": "지원인력 코드 (A01)"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1440,
                          "multipleOf": 10,
                          "description": "자정부터의 분, 10의 배수"
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1440,
                          "multipleOf": 10,
                          "description": "자정부터의 분, 10의 배수"
                        },
                        "students": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^S\\d{2,3}$",
                            "description": "학생 코드 (S01)"
                          }
                        }
                      },
                      "required": [
                        "staff",
                        "start",
                        "end",
                        "students"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "after": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "staff": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^A\\d{2,3}$",
                              "description": "지원인력 코드 (A01)"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1440,
                          "multipleOf": 10,
                          "description": "자정부터의 분, 10의 배수"
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1440,
                          "multipleOf": 10,
                          "description": "자정부터의 분, 10의 배수"
                        },
                        "students": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^S\\d{2,3}$",
                            "description": "학생 코드 (S01)"
                          }
                        }
                      },
                      "required": [
                        "staff",
                        "start",
                        "end",
                        "students"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "demand_id",
                "type",
                "before",
                "after"
              ]
            }
          },
          "explanation": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "cause": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "REQUESTED",
                        "TIMETABLE_CHANGED",
                        "MOVE_SUPPORT_NEEDED",
                        "GROUP_MOVE",
                        "EDGE_RELEASED",
                        "OVERLAP",
                        "UNAVAILABLE",
                        "CONTINUITY",
                        "GAP",
                        "REPLANNED",
                        "BALANCE",
                        "ROTATION"
                      ]
                    },
                    "op_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "params": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": [
                          "string",
                          "number"
                        ]
                      }
                    }
                  },
                  "required": [
                    "code"
                  ]
                },
                "demand_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
                  },
                  "description": "이 단계에서 바뀐 칸. 화면에서 누르면 강조"
                }
              },
              "required": [
                "step",
                "cause",
                "reason",
                "demand_ids"
              ]
            }
          }
        },
        "required": [
          "key",
          "policies",
          "label",
          "assignments",
          "shortfalls",
          "metrics",
          "diff",
          "explanation"
        ]
      }
    },
    "engine": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "heuristic",
            "cpsat"
          ]
        },
        "version": {
          "type": "string"
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "name",
        "version",
        "elapsed_ms"
      ]
    }
  },
  "required": [
    "options",
    "engine"
  ]
}
