{
  "$id": "ssyung/ValidateOutput",
  "x-contract-version": "0.2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "OVERLAP",
              "OUTSIDE_AVAILABILITY",
              "ABSENT",
              "PINNED_CHANGED",
              "MOVE_GROUP_HEADCOUNT",
              "SECOND_TRIP_WINDOW",
              "UNKNOWN_DEMAND",
              "BEFORE_NOW_CHANGED"
            ]
          },
          "staff": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^A\\d{2,3}$",
                "description": "지원인력 코드 (A01)"
              },
              {
                "type": "null"
              }
            ]
          },
          "demand_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
            }
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          }
        },
        "required": [
          "code",
          "staff",
          "demand_ids",
          "date",
          "start",
          "end"
        ]
      }
    },
    "shortfalls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "demand_id": {
            "type": "string",
            "pattern": "^(les|mv|req|duty):\\d{4}-\\d{2}-\\d{2}:[A-Za-z0-9:\\-]+$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "short_by": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "priority": {
            "type": "string",
            "enum": [
              "MOVE",
              "HIGH",
              "LOW"
            ]
          },
          "segment": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "start",
                  "mid",
                  "end"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "수업 지원일 때 구간"
          },
          "waived": {
            "type": "boolean",
            "description": "이동이 몰려 일부러 비운 체크 안 된 구간 (EDGE_RELEASED). 지원 공백으로 세지 않음"
          }
        },
        "required": [
          "demand_id",
          "date",
          "start",
          "end",
          "short_by",
          "priority",
          "segment",
          "waived"
        ]
      }
    },
    "warnings": {
      "description": "쓰지 않음. 배치 경고는 엔진 입력에 없는 정보가 필요해 API(schedule.validate)가 계산한다. 계약 1.0에서 뺀다",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "SPECIAL_CLASS_CROWDED",
              "NO_SPECIAL_TEACHER"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1440,
            "multipleOf": 10,
            "description": "자정부터의 분, 10의 배수"
          },
          "params": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "required": [
          "code",
          "date",
          "start",
          "end",
          "params"
        ]
      }
    }
  },
  "required": [
    "violations",
    "shortfalls"
  ]
}
