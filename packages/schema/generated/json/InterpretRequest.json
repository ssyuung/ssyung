{
  "$id": "ssyung/InterpretRequest",
  "x-contract-version": "0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "raw_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "실명 검사(M5)를 통과한 원문"
    },
    "context": {
      "type": "object",
      "properties": {
        "today": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD"
        },
        "calendar": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "YYYY-MM-DD"
              },
              "day": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "MON",
                      "TUE",
                      "WED",
                      "THU",
                      "FRI"
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "SAT",
                      "SUN"
                    ]
                  }
                ]
              },
              "school_day": {
                "type": "boolean"
              }
            },
            "required": [
              "date",
              "day",
              "school_day"
            ]
          }
        },
        "bell": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "class",
                  "break",
                  "lunch",
                  "arrival",
                  "dismissal",
                  "other"
                ]
              },
              "period": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1440,
                "multipleOf": 10,
                "description": "자정부터의 분, 10의 배수"
              },
              "label": {
                "type": "string",
                "maxLength": 10
              },
              "part_of_day": {
                "type": "string",
                "enum": [
                  "morning",
                  "afternoon"
                ]
              }
            },
            "required": [
              "kind",
              "period",
              "start",
              "end",
              "label",
              "part_of_day"
            ]
          }
        },
        "part_of_day": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "morning",
              "afternoon"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "morning",
            "afternoon"
          ],
          "description": "오전·오후에 드는 교시"
        },
        "class_subjects": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^\\d-\\d{1,2}$",
            "description": "원반 (3-2)"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "YYYY-MM-DD"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20,
                    "description": "NEIS 과목명 (과학)"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "description": "반 → 날짜 → 교시별 과목 (index 0 = 1교시). 학생이 속한 반만"
        },
        "codes": {
          "type": "object",
          "properties": {
            "students": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^S\\d{2,3}$",
                    "description": "학생 코드 (S01)"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "class_group": {
                    "type": "string",
                    "pattern": "^\\d-\\d{1,2}$",
                    "description": "원반 (3-2)"
                  }
                },
                "required": [
                  "code",
                  "label",
                  "class_group"
                ]
              }
            },
            "staff": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^A\\d{2,3}$",
                    "description": "지원인력 코드 (A01)"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  }
                },
                "required": [
                  "code",
                  "label"
                ]
              }
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^(\\d-\\d{1,2}|K\\d{1,2}|L\\d{2,3})$",
                    "description": "장소: 반 코드(원반 교실) | K 코드(특수학급) | L 코드(특별실 등)"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  }
                },
                "required": [
                  "code",
                  "label"
                ]
              }
            }
          },
          "required": [
            "students",
            "staff",
            "locations"
          ]
        }
      },
      "required": [
        "today",
        "calendar",
        "bell",
        "part_of_day",
        "class_subjects",
        "codes"
      ]
    }
  },
  "required": [
    "raw_text",
    "context"
  ]
}
